# Copy to .env.local (never commit it). Values come from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key          # safe to expose: Row Level Security protects the data
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key        # SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
NEXT_PUBLIC_SITE_URL=https://yashakbaby.online
SITE_URL=https://yashakbaby.online                            # read at run time (sitemap, canonical links). The owner's "website address" setting wins if filled in.
ORDER_RATE_LIMIT=20                                           # orders per address per hour (optional)

